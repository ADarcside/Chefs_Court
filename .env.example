# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/chefs_court

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Code required to sign up as JUDGE. Leave empty to disable judge signup.
JUDGE_INVITE_CODE=

# Where evidence files are stored
UPLOAD_DIR=./uploads

# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
